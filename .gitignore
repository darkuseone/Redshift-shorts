# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node / Remotion ---
node_modules/
render/remotion/out/
render/remotion/.remotion/

# --- Runtime output ---
# Сборки роликов не хранятся в репозитории — только в artifacts/S3.
/output/**
!/output/.gitkeep

# Рабочие каталоги прогонов
/work/
/.redshift_cache/

# Кэш футажей: в репозитории живёт только индекс
/cache/**
!/cache/.gitkeep
!/cache/footage_index.json

# Сырой сток и превью mp4 — не в git. Индекс footage — cache/footage_index.json.
/assets/footage/**
!/assets/footage/README.md
/assets/preview/

# mp4 нигде, кроме тестов-фикстур. Клипы аватара — webm/mov/wav.
*.mp4
!tests/**/*.mp4

# Локальные секреты
.env
.env.*
!.env.example
config/secrets.local.yaml

# --- OS ---
.DS_Store
Thumbs.db

# Витрина приёмов собирается из исходников — в репозиторий не кладём.
build/

# HyperFrames catalog downloads — never vendor HTML (ports are Python/GSAP only)
/compositions/
/hyperframes.lock.json
/vpn-youtube-spot.json
/blue-sweater.json
/flowchart.json
/flowchart-vertical.json
/us-map.json
/split-flap-board.json
/chatgpt-exchange.json
/TEMPLATE.md
*.json.log
assets/fonts/inter-*
assets/*.woff2
assets/**/*.woff2
assets/fonts/*-LICENSE.txt
assets/*.jpg
assets/hyperframes-logo-*.svg
/*.json
!package.json
!package-lock.json

