# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node / Remotion ---
node_modules/
render/remotion/out/
render/remotion/.remotion/

# --- Runtime output ---
# Сборки роликов не хранятся в репозитории (§14.5) — только в artifacts/storage.
/output/**
!/output/.gitkeep

# Рабочие каталоги прогонов (промежуточные JSON, wav, mp4 шагов пайплайна)
/work/
/.redshift_cache/

# Кэш футажей: в репозитории живёт только индекс (§14.5, K-12)
/cache/**
!/cache/.gitkeep
!/cache/footage_index.json

# Библиотека отобранного материала — наоборот, живёт в репозитории целиком:
# раннер умирает вместе с задачей, кэш Actions привязан к ролику и терялся уже
# трижды, а checkout переживает всё. См. assets/footage/README.md.

# Локальные секреты
.env
.env.*
!.env.example
config/secrets.local.yaml

# --- OS ---
.DS_Store
Thumbs.db

# Витрина приёмов собирается из исходников — в репозиторий не кладём.
build/

# HyperFrames catalog downloads — never vendor HTML (ports are Python/GSAP only)
/compositions/
/hyperframes.lock.json
/vpn-youtube-spot.json
/blue-sweater.json
/flowchart.json
/flowchart-vertical.json
/us-map.json
/split-flap-board.json
/chatgpt-exchange.json
/TEMPLATE.md
*.json.log
assets/fonts/inter-*
assets/*.woff2
assets/**/*.woff2
assets/fonts/*-LICENSE.txt
assets/card-image.jpg
assets/hyperframes-logo-black.svg
/*.json
!package.json
!package-lock.json

